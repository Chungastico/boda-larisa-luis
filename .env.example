# Server-only Neon connection string. Do not prefix with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
APP_URL="http://localhost:3000"

# Temporary server-only gate for /admin until Clerk is configured.
ADMIN_ACCESS_TOKEN="replace-with-a-long-random-value"

# Reserve these for the Clerk migration. They are intentionally unused for now.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
